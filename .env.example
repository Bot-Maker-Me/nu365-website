# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Email Configuration (Resend) - SERVER-SIDE ONLY
# These are read by the Vercel functions in api/ via process.env.
# Never expose them with a VITE_ prefix and never commit real values.
# Set the real values in Vercel Environment Variables (Production) and in .env.local for local dev.
RESEND_API_KEY=your_resend_api_key
# Optional: comma-separated list of keys; the functions try each until one succeeds.
RESEND_API_KEYS=key1,key2,key3
RECIPIENT_EMAIL=your_email@example.com
