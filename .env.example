# Supabase (public values — safe in the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Enquiry emails (Resend) — server only, never prefix with VITE_
RESEND_API_KEY=re_xxxxxxxx
RECIPIENT_EMAIL=owner@example.com
# Optional: sender on a domain verified in Resend (default only delivers to the Resend account owner)
# FROM_EMAIL=enquiries@yourdomain.com
